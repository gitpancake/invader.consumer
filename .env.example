# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=flash_queue

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Pinata Configuration (get JWT from https://app.pinata.cloud)
PINATA_JWT=your_pinata_jwt_here

# Optional Performance Settings
CONSUMER_CONCURRENCY=5
BATCH_SIZE=300
CONSUMER_RATE_LIMIT=250
CONSUMER_TIMEOUT=30000

# Memory Management
GC_THRESHOLD=0.85
MEMORY_WARNING_THRESHOLD=0.7

# Database Pool
DB_POOL_MIN=2
DB_POOL_MAX=20

# Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL=60000

# Proxy Configuration (optional)
# PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# Flash Identification (optional)
# EMBEDDINGS_API_URL=https://invaders-embeddings.railway.app
