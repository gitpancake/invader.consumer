{
  "name": "invaders.consumer",
  "packageManager": "yarn@4.3.1",
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.0.7",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.839.0",
    "@types/pg": "^8.15.5",
