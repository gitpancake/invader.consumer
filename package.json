{
  "name": "invaders.consumer",
  "packageManager": "yarn@4.3.1",
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.0.7",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.839.0",
    "@types/pg": "^8.15.5",
    "amqplib": "^0.10.8",
    "axios": "^1.10.0",
    "dotenv": "^17.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=19.9.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & nodemon dist/index.js",
    "test": "TEST_MODE=true node dist/index.js",
    "migrate": "tsc && node dist/scripts/migrate-s3-to-ipfs.js",
    "migrate:batch": "tsc && node dist/scripts/migrate-s3-to-ipfs.js",
    "migrate:parallel": "tsc && node dist/scripts/parallel-migration.js",
    "backfill": "tsc && node dist/scripts/backfill-ipfs.js",
    "test-upload": "tsc && node dist/scripts/test-dual-upload.js",
    "generate-web3-csv": "node -e \"const {CSVLogger} = require('./dist/util/csv-logger'); console.log('Generated:', CSVLogger.generateWeb3StorageCSV());\""
  }
}
